# Force Windows line endings for scripts (prevents breakage on WSL / Git Bash)
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf
*.cmd  text eol=crlf

# Force Unix line endings for macOS/Linux scripts (CRLF breaks the shebang)
*.sh       text eol=lf
*.command  text eol=lf

# ── Git LFS: large bundled runtime, model and media payload ───────────────────
# GitHub rejects normal Git blobs over 100 MB; the bundled torch DLL and Next SWC
# binary exceed that limit. Install Git LFS before cloning this repository.
*.7z         filter=lfs diff=lfs merge=lfs -text
*.zip        filter=lfs diff=lfs merge=lfs -text
*.rar        filter=lfs diff=lfs merge=lfs -text
*.whl        filter=lfs diff=lfs merge=lfs -text
