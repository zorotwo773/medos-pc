# MedOS backend configuration — copy to .env and fill in values.
# NEVER commit .env to version control.

# ── Server ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8002
# Comma-separated origins. Add your LAN IP for mobile/tablet access.
# Example: http://localhost:3000,http://192.168.1.100:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Project root (all data paths resolve relative to this) ────────────────
# Leave commented when data lives under the cloned repo root.
# MEDOS_ROOT=C:\path\to\MedOS

# ── Data paths (leave blank to use ROOT-relative defaults) ────────────────
# LIBRARY_PATH=C:\path\to\MedOS\data\books
# UTD_DB_PATH=C:\path\to\MedOS\data\uptodate
# AMBOSS_DIR=C:\path\to\MedOS\data\amboss
# STEP1_DB_PATH=C:\path\to\MedOS\data\uworld\STEP-1-2026-march\uworldSTEP1-2026-march.db
# STEP2_DB_PATH=C:\path\to\MedOS\data\uworld\STEP2-2026-march\uworldSTEP2-2026-march.db
# STEP3_DB_PATH=C:\path\to\MedOS\data\uworld\STEP3-2026-march\uworldSTEP3-2026-march.db
# LEXI_DB_PATH=C:\path\to\MedOS\data\lexi.db
# HARRISONS_PATH=C:\path\to\MedOS\app\public\harrisons_database.json
# ANATOMY_DEFS_PATH=C:\path\to\MedOS\data\anatomy
# VECTORSTORE_PATH=C:\path\to\MedOS\data\faiss\books_v1
# BOOK_CHAPTER_INDEX_DB=C:\path\to\MedOS\data\book_chapter_index.sqlite
# GLOSSARY_DB=C:\path\to\MedOS\data\glossary.db
# REFERENCE_ENTITIES_DB=C:\path\to\MedOS\data\reference_entities.sqlite
# REFERENCE_LOOKUP_DB=C:\path\to\MedOS\data\reference_lookup.sqlite
# CONCEPT_LINKS_DB=C:\path\to\MedOS\data\concept_links.sqlite
# FIRSTAID_PDF=C:\path\to\MedOS\data\books\USMLE\First Aid for the USMLE Step 1 2026.pdf
# FIRSTAID_INDEX_DB=C:\path\to\MedOS\data\firstaid_index.sqlite
# FA_SNIPPET_CACHE_DIR=C:\path\to\MedOS\data\_fa_snippet_cache
# DRUG_REF_DB=C:\path\to\MedOS\data\drug_reference.sqlite
# MICROMEDEX_DB=C:\path\to\MedOS\data\Lexi\mm\imdiMDX_DrugRef.sqlite
# QBANK_STATE_DB=C:\path\to\MedOS\data\qbank_state.sqlite3
# ANKI_MEDIA_DIR=C:\path\to\MedOS\data\anki\collection.media
# FAISS_DIR=C:\path\to\MedOS\data\faiss
# BM25_DIR=C:\path\to\MedOS\data\bm25
# MODELS_DIR=C:\path\to\MedOS\models
# AO_DATA_PATH=C:\path\to\MedOS\data\ao

# ── Anki integration ───────────────────────────────────────────────────────
# Preferred portable layout after copying to a new laptop:
#   data\anki\collection.anki2
#   data\anki\collection.media\
# Leave blank to auto-detect data\anki first, then the normal Windows Anki profile.
# ANKI_COLLECTION=C:\path\to\MedOS\data\anki\collection.anki2
# ANKI_MEDIA_DIR=C:\path\to\MedOS\data\anki\collection.media

# ── AI credentials ─────────────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=

# ── Embedding / reranker ───────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ── UTD decryption ────────────────────────────────────────────────────────
UTD_PASSWORD=
