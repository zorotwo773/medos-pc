# MedOS production env — copy to infra/.env.production on the VM and fill in.
#
#   cp infra/.env.production.example infra/.env.production
#   chmod 600 infra/.env.production
#   $EDITOR infra/.env.production
#
# infra/.env.production is gitignored (see app/.gitignore additions).

# ─── Auth gate ────────────────────────────────────────────────────────────
# Shared access code typed into the /login page. Pick something memorable
# but not guessable — testers receive this via DM along with the URL.
MEDOS_ACCESS_CODE=change-me-before-deploying

# Long random secret used to sign session cookies. Generate fresh:
#   openssl rand -base64 48
# Rotating this logs out every tester (they re-enter code + name).
MEDOS_SESSION_SECRET=please-replace-with-openssl-rand-base64-48

# Cookie name + lifetime (days). Defaults are fine.
MEDOS_COOKIE_NAME=medos_session
MEDOS_COOKIE_TTL_DAYS=30

# Set "true" when running behind HTTPS (Tailscale Funnel terminates TLS,
# so this should be true in production). Tells the backend to mark the
# cookie Secure and to trust X-Forwarded-Proto.
MEDOS_TRUST_PROXY=true

# ─── External AI APIs (optional — leave blank to disable those endpoints) ─
NVIDIA_API_KEY=
GEMINI_API_KEY=

# ─── Container UID/GID — match the host user that owns /data ─────────────
# Default Oracle Ubuntu user is `ubuntu` = 1000:1000.
APP_UID=1000
APP_GID=1000
