{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/uptodate/layout,_N_T_/uptodate/page,_N_T_/uptodate"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/uptodate/__PAGE__",
    "/uptodate",
    "/_index",
    "/_head"
  ]
}